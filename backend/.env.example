# Local development. On Render set the same keys as environment
# variables, but omit PORT — the platform provides it.

PORT=3002
NODE_ENV=development

# Public base URL of THIS application (no trailing slash).
BASE_URL=http://skills.localhost:3002

# Auth0 tenant domain, with scheme.
OIDC_ISSUER=https://YOUR-TENANT.eu.auth0.com

# Auth0 -> Applications -> Skills App -> Settings
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Auth0 -> Applications -> APIs -> Skillbridge API -> Identifier.
# The same value in every service: it becomes the `aud` claim.
API_AUDIENCE=https://skillbridge-api

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Where the other application lives — used only for a link in the UI.
JOBS_APP_URL=http://jobs.localhost:3000
